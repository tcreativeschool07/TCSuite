# Django
SECRET_KEY=
DEBUG=False
# Comma-separated. In production: your-service.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Supabase pooler host, port 5432)
DB_NAME=
DB_USER=
DB_HOST=
DB_PORT=5432
DB_PASSWORD=

# Production only — comma-separated, include the scheme.
# CSRF_TRUSTED_ORIGINS lets you log into /admin/ on the deployed domain.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=
